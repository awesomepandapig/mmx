CLUSTER_NAME=mmx-node
CLUSTER_SIZE=3
CLUSTER_ID=0
AERON_DIR=/dev/shm/aeron
DATA_DIR=/data
PIN_THREADS=true
LEADER_HEARTBEAT_TIMEOUT=500ms
LEADER_HEARTBEAT_INTERVAL=100ms
ELECTION_TIMEOUT=500ms
STARTUP_CANVASS_TIMEOUT=5s
SESSION_TIMEOUT=30s
THREADING=DEDICATED
IDLE=org.agrona.concurrent.BusySpinIdleStrategy
SPARSE_TERM_BUFFERS=false
SOCKET_BUFFER=4m
LOG_TERM_LENGTH=16m
SYNC=0
JAVA_HEAP_MIN=512m
JAVA_HEAP_MAX=2g
REPORT_TERM_LENGTH=64m
MAX_ORDERS=1000000
PUB_STREAM_ID=1002
RUST_LOG=info
RUST_BACKTRACE=1
