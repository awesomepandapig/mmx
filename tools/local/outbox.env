# Sample outbox settings for `tools/scripts/sbx.py up --cluster`. These are for a laptop: set your
# game's own URL and a real secret anywhere else.
#
# `tools/scripts/sbx.py e2e` listens on this URL as a stand-in game. With nothing listening the
# outbox keeps every event and retries, so that isn't an error.
WEBHOOK_URL=http://127.0.0.1:8095/webhook
WEBHOOK_SECRET=local-development-secret
# Unauthenticated, so it stays on localhost.
OUTBOX_HTTP=127.0.0.1:8092
