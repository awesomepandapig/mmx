{
  "name": "web",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "remix vite:build",
    "dev": "remix vite:dev",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "remix-serve ./build/server/index.js",
    "fmt": "NODE_OPTIONS='--experimental-strip-types' prettier . --write",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.11",
    "@remix-run/node": "2.17.5",
    "@remix-run/react": "2.17.5",
    "@remix-run/serve": "2.17.5",
    "clsx": "^2.1.1",
    "isbot": "^4.1.0",
    "lucide-react": "^0.483.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@remix-run/dev": "2.17.5",
    "@types/react": "^18.2.20",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.38.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.38",
    "prettier": "3.5.3",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.1.6",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^4.2.1",
    "@vercel/remix": "2.16.7"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@vercel/remix": {
      "@remix-run/dev": "$@remix-run/dev",
      "@remix-run/node": "$@remix-run/node",
      "@remix-run/server-runtime": "2.17.5"
    }
  }
}
