# AERON_DIR defaults to /Volumes/DevShm/aeron on macOS and /dev/shm/aeron on Linux.

SUB_CHANNEL="aeron:udp?endpoint=localhost:40123"
SUB_STREAM_ID="1001"
PUB_CHANNEL="aeron:udp?control=localhost:40456|control-mode=dynamic"
PUB_STREAM_ID="1002"

TLS_ENABLED = "TRUE" # Default True

VERSION="v0.1.0"
GIT_COMMIT_HASH = ""

MAX_ORDERS="1000000"

# Cluster mode. A limit of 0 turns that snapshot trigger off.
SNAPSHOT_LOG_BYTES="1073741824"
SNAPSHOT_INTERVAL_SECS="3600"
SNAPSHOTS_KEPT="3"

# Unset keeps the tape forever. When set, the tape also needs a `tape-swept` command before any of
# it is purged, and these newest bytes always stay.
# TAPE_RETENTION_BYTES="107374182400"

# The outbox's durable output position. Unset, a total loss can't be detected.
# DURABLE_POSITION="0"
# Lets a leader join below DURABLE_POSITION to wait for `matching-engine admin rebuild`.
# RECOVERY_MODE="rebuild"
